{
  "expo": {
    "name": "ATO",
    "slug": "ato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ATO.png",
    "scheme": "myperiodtracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ATO.png"
    },
    "android": {
      "package": "com.myperiodtracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ATO.png",
        "backgroundColor": "#FFF5F8"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ATO.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ATO.png",
          "backgroundColor": "#FFF5F8",
          "imageWidth": 150
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "33daa28d-fcc2-415b-ae70-d24370fde367"
      }
    }
  }
}
